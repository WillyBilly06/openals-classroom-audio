<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the Flutter splash overlay gradient:
     topLeft #1C5A44 -> center #154734 -> bottomRight #0E3325 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#1C5A44"
        android:centerColor="#154734"
        android:endColor="#0E3325" />
</shape>
